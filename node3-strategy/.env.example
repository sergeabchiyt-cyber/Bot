# Node 1 is market data only. Node 3 builds every profile itself from closed bars.
NODE1_WS_URL=wss://engine-southeastasia-sng-main.onrender.com/ws

# Node 3 public HTTP/WS and private Node 4 WS share this listener.
PORT=10000

# Required for Node 4 to authenticate to WS /execution. Use the same long,
# random value on Node 4. Never expose this value to Node 2/browser code.
NODE4_SHARED_TOKEN=replace-with-a-long-random-service-secret

# An intent is invalid after this many seconds. Node 4 must enforce the same
# expires_at value before any broker write.
SIGNAL_TTL_SECS=120
# Bounded replay queue. A full queue refuses new intents fail-closed.
MAX_PENDING_INTENTS=128

# ---- Volume profile (Node 3 owns all VP maths) ----
# Fixed New York anchor: Sunday 18:00 America/New_York, DST-aware. Only this value is supported.
WEEK_ANCHOR=sunday-1800-America/New_York
# Value-area share of volume, in percent. 70 = 70%.
VA_PCT=70
# Rows per profile (2-5000).
VP_ROWS=128
# rows (default) or price bins.
VP_ROW_MODE=rows
# Fixed bin width in price units, used only when VP_ROW_MODE=price.
VP_BIN_SIZE=0.50
# tv (TradingView ladder, default) or an explicit 1m/5m/15m/1h label.
VP_LOWER_TF=tv
# PS mode. week_open freezes PS at the week open. rolling tracks the last closed session.
PS_MODE=week_open
# Trading weekday on which CW first publishes: Mon (default) or Wed.
CW_FIRST_PUBLISH_WEEKDAY=Mon
# Closed bars kept in memory. Never below 35.
RETAIN_DAYS=35

# ---- Strategy and risk ----
# Node 1 interval that drives break and retest evaluation: 1m, 15m, or 1h.
STRATEGY_INTERVAL=15m
# Volume gate. 0 = OFF (default, decision D6). A positive value enables the gate.
VOLUME_THRESHOLD=0
SL_MIN_PIPS=200
SL_MAX_PIPS=300
TP_MIN_PIPS=600
TP_MAX_PIPS=800
RR_MIN=2.0
RR_MAX=3.0
# Stop and target as ATR(14) multiples before clamping to the bands above.
SL_ATR_MULT=1.0
TP_ATR_MULT=2.0

# Strategy-only parameters. There are deliberately no broker, MT5, account,
# venue, stake, lot-size, or API-token variables in Node 3.
RUST_LOG=info
