# Node 1 is market data + volume profile only.
NODE1_WS_URL=wss://engine-southeastasia-sng-main.onrender.com/ws

# Node 3 public HTTP/WS and private Node 4 WS share this listener.
PORT=10000

# Required for Node 4 to authenticate to WS /execution. Use the same long,
# random value on Node 4. Never expose this value to Node 2/browser code.
NODE4_SHARED_TOKEN=replace-with-a-long-random-service-secret

# An intent is invalid after this many seconds. Node 4 must enforce the same
# expires_at value before any broker write.
SIGNAL_TTL_SECS=120
# Bounded replay queue. A full queue refuses new intents fail-closed.
MAX_PENDING_INTENTS=128

# Strategy-only parameters. There are deliberately no broker, MT5, account,
# venue, stake, lot-size, or API-token variables in Node 3.
VOLUME_THRESHOLD=10500
SL_MIN_PIPS=200
SL_MAX_PIPS=300
TP_MIN_PIPS=600
TP_MAX_PIPS=800
RR_MIN=2.0
RR_MAX=3.0
RUST_LOG=info
