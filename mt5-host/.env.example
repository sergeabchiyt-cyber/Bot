# mt5-host environment — reference for the Linux/Render deployment.
#
# This file is documentation, not a loader: mt5-host (like mt5-bridge) reads the
# *process* environment only. Nothing here is read from disk, so either put
# these values in Render's "Environment" tab / a systemd `EnvironmentFile`, or
# export them in the shell before starting the binary:
#
#     set -a; . ./.env; set +a; mt5-host
#
# Everything is optional except the two entries marked REQUIRED, which the host
# checks at startup and refuses to boot without (exit code 2, nothing launched).

# ─── service ─────────────────────────────────────────────────────────────────
# Render injects PORT; the host falls back to MT5_HOST_PORT and then 10000.
PORT=10000
# Only needed outside Render, where nothing injects PORT.
# MT5_HOST_PORT=10000

# Where the Wine prefix, the startup ini and the bridge history live. On Render
# free instances this directory is *not* persistent: it is re-created from the
# image on every deploy (see README §Persistence).
MT5_HOST_STATE_DIR=/data

# 1 = run the boot stages (display → prefix → install → EA → startup ini) and
# exit without starting the terminal or the bridge. This is how the pre-baked
# prefix image in ci/mt5/Dockerfile.bundle-image is built, and how you smoke-test
# an install without credentials.
# MT5_HOST_PREPARE_ONLY=0

# ─── virtual display ─────────────────────────────────────────────────────────
# MT5 is a Windows GUI application; Xvfb is what makes it headless.
MT5_HOST_DISPLAY=:99
MT5_HOST_SCREEN=640x480x16
# MT5_HOST_XVFB_BIN=Xvfb

# ─── wine ────────────────────────────────────────────────────────────────────
# WINEPREFIX is the standard Wine variable; default is $MT5_HOST_STATE_DIR/wine.
WINEPREFIX=/data/wine
# MT5_HOST_WINE_BIN=wine
# Extra arguments for `wineboot -u`, rarely needed.
# MT5_HOST_WINEBOOT_ARGS=

# ─── terminal install ────────────────────────────────────────────────────────
# The unattended installer. Baked into the image at /opt/mt5/mt5setup.exe; if it
# is missing or empty the host downloads MT5_HOST_INSTALLER_URL instead.
MT5_HOST_INSTALLER=/opt/mt5/mt5setup.exe
# MT5_HOST_INSTALLER_URL=https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe
# Offline fast path: a tar.gz of a pre-installed prefix (`wine/` at the archive
# root). Unpacked into $MT5_HOST_STATE_DIR, so a redeploy on a free instance
# skips the whole installer + download. Build it with
# `ci/mt5/Dockerfile.bundle-image` or `MT5_HOST_PREPARE_ONLY=1` + tar.
# MT5_HOST_PREFIX_ARCHIVE_URL=https://example.invalid/mt5-prefix.tar.gz
# MT5_HOST_TAR_BIN=tar
# MT5_HOST_CURL_BIN=curl

# ─── terminal login (REQUIRED unless MT5_HOST_MANUAL_LOGIN=1) ────────────────
# The terminal is logged in by the startup ini: [Common] Login/Password/Server.
# Use an MQL5 demo account (Deriv demo logins may not be accepted by the
# MetaQuotes terminal). The password is never logged, never written to
# diagnostics and never stored in a prepared prefix.
MT5_LOGIN=
# MT5_PASSWORD=
# Exact server name from the terminal's login dialog, e.g. "MetaQuotes-Demo".
MT5_SERVER=

# Set this instead when the terminal is already logged in some other way — the
# terminal then survives redeploys only as long as its prefix does. Mutually
# exclusive with the three variables above.
# MT5_HOST_MANUAL_LOGIN=1

# ─── EA + bridge wiring (REQUIRED: NODE4_WS_URL, MT5_BRIDGE_TOKEN) ───────────
# Where the bridge dials out. Node 4's private bridge endpoint:
#   ws://<node4-host>:10000/mt5/bridge   (outbound WS, so no inbound port here)
NODE4_WS_URL=wss://your-node4-service.onrender.com/mt5/bridge
# Must equal Node 4's MT5_BRIDGE_TOKEN. Secret.
MT5_BRIDGE_TOKEN=
# Shared secret the EA and the bridge use on their loopback socket. Leave unset
# for a read-only monitor: the bridge then refuses order requests.
# MT5_EA_TOKEN=
# MT5_EA_PORT=5055
# MT5_MAGIC=330033

# ─── symbols ─────────────────────────────────────────────────────────────────
MT5_SYMBOL=XAUUSD
# Broker suffix mapping, e.g. "XAUUSD=XAUUSD.a". The mapped spellings are added
# to the EA's allow-list automatically.
# MT5_SYMBOL_MAP=
# Replace the derived allow-list entirely.
# MT5_HOST_ALLOWED_SYMBOLS=

# ─── startup ini ─────────────────────────────────────────────────────────────
# Chart period for the startup chart (1 = M1). The EA does not depend on it.
MT5_HOST_PERIOD=1
# MT5_HOST_EA_NAME=Mt5BridgeEA
# Override the EA source (defaults to the Mt5BridgeEA.mq5 embedded in the
# binary at compile time, kept identical to mt5-bridge/mql5/Mt5BridgeEA.mq5).
# MT5_HOST_EA_SOURCE=/app/override/Mt5BridgeEA.mq5
# Extra flags appended to the terminal64.exe command line.
# MT5_HOST_EXTRA_TERMINAL_ARGS=
# 1 = also write a fallback chart profile (only useful when the [StartUp] block
# fails on this terminal build).
# MT5_HOST_WRITE_PROFILE=0

# ─── bridge process ──────────────────────────────────────────────────────────
MT5_HOST_BRIDGE_BIN=/usr/local/bin/mt5-bridge
# Trading stays off until the documented demo integration gate passes. Both the
# EA and Node 4 enforce the same gate; this is only the outermost switch.
MT5_TRADING_ENABLED=0
# Where the bridge writes its order/fill history (defaults to
# $MT5_HOST_STATE_DIR/mt5_history.jsonl).
# MT5_HISTORY_FILE=/data/mt5_history.jsonl
# Bridge log level (the host defaults it to "info" only when it is unset).
RUST_LOG=info

# ─── timing (seconds; raise these on a cold free instance) ───────────────────
# MT5_HOST_DISPLAY_TIMEOUT_SECS=60
# MT5_HOST_WINEBOOT_TIMEOUT_SECS=600
# MT5_HOST_INSTALL_TIMEOUT_SECS=2400
# MT5_HOST_COMPILE_TIMEOUT_SECS=600
# How long to wait for the EA to connect before restarting the terminal.
# MT5_HOST_EA_WAIT_SECS=420
# MT5_HOST_PREFIX_DOWNLOAD_TIMEOUT_SECS=1800

# ─── supervision ─────────────────────────────────────────────────────────────
# Warn on /diagnostics when the container's RSS passes this (free tier = 512 MB).
MT5_HOST_RSS_WARN_MB=420
# Terminal restarts allowed per hour before the host holds off for 5 minutes.
MT5_HOST_MAX_RESTARTS_PER_HOUR=5
# How often Node 4's /mt5/status is polled for /diagnostics.
MT5_HOST_NODE4_POLL_SECS=15
