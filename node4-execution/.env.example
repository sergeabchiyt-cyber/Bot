# Node 4 — execution + risk management service (.env template; NEVER commit .env)
# ---------------------------------------------------------------------------
# Node 4 has exactly ONE intent source: Node 3's authenticated private
# `WS /execution`. There is no local strategy, no Node 1 feed consumer and no
# second dashboard in this branch. Market data and decisions belong to
# Nodes 1 and 3; see contracts/README.md and PLAN.md.
#
# Demo by default. With no credentials the venue is `none`: intents are
# validated, checked against risk policy, durably recorded and reported, but
# NO broker order is placed. A real venue additionally requires the demo
# integration gate; a live venue requires explicit live approval.

# ---------------------------------------------------------------------------
# Node 3 intent link (outbound; Node 4 is the CLIENT)
# ---------------------------------------------------------------------------
# wss://<node3-host>/execution. Node 4 sends `execution_hello` first and
# refuses any intent until Node 3 answers `execution_hello_ack {accepted:true}`.
NODE3_WS_URL=wss://strategy-southeastasia-sng-main.onrender.com/execution
# Shared secret sent in execution_hello. Must equal Node 3's
# NODE4_SHARED_TOKEN. NOT the bridge token. Generate: openssl rand -hex 32
NODE4_SHARED_TOKEN=
NODE3_HELLO_TIMEOUT_MS=10000
NODE3_RECONNECT_MIN_MS=1000
NODE3_RECONNECT_MAX_MS=30000
# Silence this long marks the link stale; no new broker write is attempted.
NODE3_STALE_MS=45000

# ---------------------------------------------------------------------------
# Risk management (Node 4 owns every account-aware decision)
# ---------------------------------------------------------------------------
# Strategy price bands. Node 3 projects ATR-scaled SL/TP; Node 4 REJECTS (never
# rewrites) an intent outside these bands. 1 pip = $0.01 on XAUUSD, so
# 200-300 pips = $2-3 and 600-800 pips = $6-8, RR 2-3.
RISK_SL_MIN_PIPS=200
RISK_SL_MAX_PIPS=300
RISK_TP_MIN_PIPS=600
RISK_TP_MAX_PIPS=800
RISK_RR_MIN=2.0
RISK_RR_MAX=3.0
RISK_PIP_VALUE=0.01
# Ounces per lot on Deriv MT5 XAUUSD. Used to price risk in USD.
RISK_CONTRACT_SIZE=100
# Optional hard caps; empty disables that individual cap.
RISK_MAX_RISK_USD=
RISK_MAX_DAILY_LOSS_USD=
RISK_MAX_DRAWDOWN_PCT=
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_LOTS=1.00
# Stop trading for RISK_COOLDOWN_SECS after this many consecutive losing closes.
RISK_COOLDOWN_LOSSES=3
RISK_COOLDOWN_SECS=900

# ---------------------------------------------------------------------------
# Demo / live gates
# ---------------------------------------------------------------------------
# Required before ANY real venue may be driven (MT5 demo integration gate in
# docs/mt5/EXECUTION_ARCHITECTURE.md must have passed first).
NODE4_DEMO_INTEGRATION_PASSED=
# Required for EXECUTION_VENUE=chelsea_live. Live is never the default.
NODE4_LIVE_TRADING_APPROVED=

# ---------------------------------------------------------------------------
# Venue policy — exactly one, no fallback
# ---------------------------------------------------------------------------
# none (explicit dry-run) | deriv_mt5_demo | deriv_demo | chelsea_live
EXECUTION_VENUE=none
# Append-only, fsynced idempotency ledger. Written BEFORE any broker write.
EXECUTION_LEDGER_FILE=data/execution_ledger.jsonl
# Deriv options stake in USD. ORDER_SIZE is a deprecated alias.
EXECUTION_STAKE=0.50
DERIV_MIN_STAKE=0.50
DERIV_DEMO_API=
DERIV_APP_ID=
DERIV_API_URL=https://api.derivws.com
# Chelsea live MCP (opt-in, live).
MCP_CHELSEA_URL=

# ---------------------------------------------------------------------------
# MT5 demo venue (deriv_mt5_demo) — bridge dials OUT to Node 4
# ---------------------------------------------------------------------------
# Node 4 never holds MT5_LOGIN / MT5_PASSWORD; they live with mt5-bridge.
MT5_BRIDGE_TOKEN=
# Operator kill switch: POST /mt5/control with X-Control-Token. Unset => 403.
MT5_CONTROL_TOKEN=
MT5_SYMBOL=XAUUSD
# Optional exact broker-symbol overrides, e.g. XAUUSD=XAUUSD.a
MT5_SYMBOL_MAP=
MT5_ALLOW_OTHER_SYMBOL=0
MT5_VOLUME_LOTS=0.01
# Optional hard cap on |entry - SL| x lots x contract size (USD).
MT5_MAX_RISK_PER_TRADE=
MT5_ORDER_TIMEOUT_MS=15000
MT5_HISTORY_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
PORT=10000
RUST_LOG=info
