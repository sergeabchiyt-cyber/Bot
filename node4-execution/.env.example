# Node 4 — execution service (xauusd-node4-execution)
#
# Role: execution_only. Node 4 consumes trade intents from Node 3, owns the
# idempotency ledger, sizing, venue policy and all broker adapters. It never
# runs strategy or market analytics — intent parameters (SL/TP/RR) come from
# Node 3 and are only validated, never recomputed.

# ---------------------------------------------------------------------------
# Node 3 link (authenticated, outbound — Node 4 dials Node 3)
# ---------------------------------------------------------------------------
# Node 3's execution endpoint. Node 4 connects with WS and sends
# `execution_hello` (carrying NODE4_SHARED_TOKEN) as its first frame.
# Unset => monitor-only: public endpoints work, but no broker writes happen.
NODE3_WS_URL=
# Shared secret validated by Node 3 in `execution_hello`. Generate one:
#   openssl rand -hex 32
NODE4_SHARED_TOKEN=
# Durable idempotency + audit ledger (JSONL, append+flush). Loaded at startup;
# duplicate intent_id never produces a second order. Never contains secrets.
EXECUTION_LEDGER_FILE=data/execution_ledger.jsonl

# Local HTTP & WebSocket port — hosting platforms inject PORT
PORT=10000

# ---------------------------------------------------------------------------
# Execution Venues — EXACTLY ONE may be configured.
# ---------------------------------------------------------------------------
# Setting a second one is a startup error on purpose: one account at a time,
# no fallback. Venue is auto-detected when exactly one credential set is
# present. An explicit EXECUTION_VENUE must still be the ONLY one configured —
# unset the other venue's credential when switching.
#   deriv_mt5_demo | deriv_demo | chelsea_live | none
EXECUTION_VENUE=
# `none` = dry-run (the default): intents are validated, durably claimed and
# reported, but no broker call is made.

# ---------------------------------------------------------------------------
# Deriv demo credentials (venues deriv_demo and deriv_mt5_demo)
# ---------------------------------------------------------------------------
# Deriv demo token: legacy `a1-...` (no app id needed) or `pat_...` (REQUIRES DERIV_APP_ID).
# A PAT (pat_...) without DERIV_APP_ID fails with:
#   HTTP 401: Deriv-App-ID header is required for PAT tokens
DERIV_DEMO_API=
# REQUIRED whenever DERIV_DEMO_API is a PAT (pat_...) token, ignored for legacy a1-... tokens.
# Free app registration: https://developers.deriv.com  (API dashboard) -> create an app -> copy its App ID.
# Must be set in the environment of the running service (e.g. Render -> Environment), not only in a local .env.
DERIV_APP_ID=
# Optional: default https://api.derivws.com (current REST + OTP API).
# Leave as-is for PAT tokens; legacy a1-... tokens may use wss://ws.derivws.com/websockets/v3.
DERIV_API_URL=https://api.derivws.com

# ---------------------------------------------------------------------------
# Chelsea Live (venue chelsea_live)
# ---------------------------------------------------------------------------
# MCP_CHELSEA_URL=http://localhost:3002/mcp

# ---------------------------------------------------------------------------
# Deriv MT5 **demo** venue — bridge protocol
# ---------------------------------------------------------------------------
# The MT5 bridge runs NEXT TO the terminal (see docs/mt5/EXECUTION_ARCHITECTURE.md),
# dials out to this service's /mt5/bridge and authenticates with this token via
# `bridge_hello`. Node 4 never sees MT5_LOGIN / MT5_PASSWORD — those are read by
# the bridge from its own env.
# Generate one:  openssl rand -hex 32
MT5_BRIDGE_TOKEN=
# Operator kill switch: `POST /mt5/control` {action: halt|resume|close_all|close_position}
# with header `X-Control-Token: $MT5_CONTROL_TOKEN`. Unset => 403 for every
# caller (remote control disabled), which is the default.
MT5_CONTROL_TOKEN=
# Requested instrument (the strategy is XAUUSD-only) and the broker's symbol for
# it. Usually the same on Deriv MT5 (`XAUUSD`); some servers suffix it
# (`XAUUSD.a`) or call it `GOLD`. Mapping is NEVER guessed — either the exact
# name works, or MT5_SYMBOL_MAP must say so.
MT5_SYMBOL=XAUUSD
# Broker-symbol overrides, `requested=broker` pairs: MT5_SYMBOL_MAP=XAUUSD=XAUUSD.a,XAUUSD.m=GOLD
MT5_SYMBOL_MAP=
# Set only if a non-XAUUSD instrument is genuinely intended.
MT5_ALLOW_OTHER_SYMBOL=0
# Order size in LOTS. On Deriv MT5, 1.00 lot of XAUUSD is 100 oz, so 0.01 lot
# is 1 oz and $1 of XAUUSD movement is USD 0.01. The bridge re-validates this
# against volume_min/max/step from the terminal and refuses the order if the
# grid does not accept it.
MT5_VOLUME_LOTS=0.01
# Optional hard cap: refuse an order whose risk (|entry - SL| x lots x contract
# size) exceeds this many account-currency units. Unset => no extra cap; the
# broker's margin + volume rules still apply.
MT5_MAX_RISK_PER_TRADE=
# How long Node 4 waits for the bridge's *confirmed* fill before treating the
# outcome as unknown (never "opened"). Keep it above the bridge's own
# MT5_ORDER_TIMEOUT_MS.
MT5_ORDER_TIMEOUT_MS=15000
# Page size used when asking the bridge for closed-deal history.
MT5_HISTORY_PAGE_SIZE=100

RUST_LOG=info
