# Node 4 — execution service (.env template; copy to .env and never commit it)
# ---------------------------------------------------------------------------
# Node 4 owns broker execution only: it consumes authenticated trade intents
# from Node 3, applies venue policy, places at most one broker order per
# `intent_id`, and reports the broker-authoritative result back. It contains no
# market analytics and no strategy logic, and it never reconstructs Node 3's
# stop-loss or take-profit.
#
# Reading order:
#   docs/EXECUTION_ARCHITECTURE note: docs/mt5/EXECUTION_ARCHITECTURE.md (MT5 demo venue)
#   bridge ⇄ Node 4 contract: mt5-bridge/README.md
#   protocol with Node 3:     docs/NODE3_NODE4_PROTOCOL.md (Node 3 repository)

# ---------------------------------------------------------------------------
# Node 3 intent link (outbound; Node 4 is the CLIENT)
# ---------------------------------------------------------------------------
# wss://<node3-host>/execution — the private execution socket. Node 4 sends
# `execution_hello` first and refuses to accept any intent until Node 3 answers
# `execution_hello_ack { accepted: true }`. Missing/invalid => startup fails.
NODE3_WS_URL=wss://strategy-southeastasia-sng-main.onrender.com/execution
# Shared secret sent in `execution_hello`. Must equal Node 3's
# NODE4_SHARED_TOKEN. This is NOT the MT5 bridge token: one secret per link.
# Generate: openssl rand -hex 32
NODE4_SHARED_TOKEN=
# Handshake deadline and bounded reconnect backoff (milliseconds).
NODE3_HELLO_TIMEOUT_MS=10000
NODE3_RECONNECT_MIN_MS=1000
NODE3_RECONNECT_MAX_MS=30000
# Silence this long from Node 3 marks the link stale; no new broker write is
# attempted against a link state that cannot be trusted.
NODE3_STALE_MS=45000

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Hosting platforms inject PORT; the server binds 0.0.0.0:$PORT.
PORT=10000
# Append-only JSONL idempotency ledger. `intent_id` is the system-wide key:
# it is persisted before any broker write, replayed on a repeat, and re-read at
# startup, so a restart can never place a second order for the same intent.
# With a real venue selected, an unwritable ledger is a hard refusal to trade.
EXECUTION_LEDGER_FILE=data/execution_ledger.jsonl
RUST_LOG=info

# ---------------------------------------------------------------------------
# Execution venue — EXACTLY ONE may be configured
# ---------------------------------------------------------------------------
#   deriv_mt5_demo | deriv_demo | chelsea_live | none
# `none` is an explicit dry-run/signal mode: intents are validated, durably
# recorded and reported, and NO broker order is placed.
# Two configured credential sets are a startup error: Node 4 never falls back
# to another venue, and never guesses which account to trade. Leave
# EXECUTION_VENUE empty to auto-detect the single configured venue.
EXECUTION_VENUE=

# ---------------------------------------------------------------------------
# Deriv options demo venue (deriv_demo)
# ---------------------------------------------------------------------------
# Legacy `a1-...` token (no app id needed) or `pat_...` (REQUIRES DERIV_APP_ID).
# A PAT without DERIV_APP_ID fails with:
#   HTTP 401: Deriv-App-ID header is required for PAT tokens
DERIV_DEMO_API=
# REQUIRED whenever DERIV_DEMO_API is a PAT (pat_...) token; ignored for `a1-`.
# Free app registration: https://developers.deriv.com -> create an app -> App ID.
# Must be set in the running service's environment, not only in this file.
DERIV_APP_ID=
# Optional: default https://api.derivws.com (REST + OTP). Legacy a1-... tokens
# may instead use wss://ws.derivws.com/websockets/v3 (keeps `?app_id=`).
DERIV_API_URL=https://api.derivws.com
# USD stake per options order. NOT a lot size: MT5_VOLUME_LOTS is the MetaTrader
# one, and the two are never interchanged. `ORDER_SIZE` is accepted as an alias.
# A stake below DERIV_MIN_STAKE is clamped up with a warning.
EXECUTION_STAKE=0.50
DERIV_MIN_STAKE=0.50
# or: Chelsea Live MCP venue (chelsea_live)
# MCP_CHELSEA_URL=http://localhost:3002/mcp

# ---------------------------------------------------------------------------
# Deriv MT5 **demo** venue (deriv_mt5_demo)
# ---------------------------------------------------------------------------
# The bridge runs NEXT TO the MT5 terminal, dials out to WS /mt5/bridge and
# authenticates with MT5_BRIDGE_TOKEN. Node 4 never connects to the bridge and
# never sees MT5_LOGIN / MT5_PASSWORD — those are read by the bridge from its
# own environment (see mt5-bridge/.env.example).
#
# Shared secret for the bridge handshake. Absent => the MT5 venue is
# unconfigured and /mt5/* stays inert. Generate: openssl rand -hex 32
MT5_BRIDGE_TOKEN=
# Operator kill switch: `POST /mt5/control`
# {action: halt|resume|close_all|close_position} with `X-Control-Token:
# $MT5_CONTROL_TOKEN`. Unset => 403 for every caller (remote control disabled),
# which is the default. Separate secret from MT5_BRIDGE_TOKEN.
MT5_CONTROL_TOKEN=
# Requested instrument (the strategy is XAUUSD-only) and the broker's symbol for
# it. Usually identical on Deriv MT5 (`XAUUSD`); some servers suffix it
# (`XAUUSD.a`) or call it `GOLD`. Mapping is NEVER guessed — either the exact
# name works, or MT5_SYMBOL_MAP must say so. Missing mapping => startup error.
MT5_SYMBOL=XAUUSD
# Broker-symbol overrides, `requested=broker` pairs:
#   MT5_SYMBOL_MAP=XAUUSD=XAUUSD.a,XAUUSD.m=GOLD
MT5_SYMBOL_MAP=
# Set only if a non-XAUUSD instrument is genuinely intended.
MT5_ALLOW_OTHER_SYMBOL=0
# Order size in LOTS (1.00 lot of XAUUSD is 100 oz on Deriv MT5). The bridge
# re-validates it against volume_min/max/step and refuses a volume the broker's
# grid does not accept.
MT5_VOLUME_LOTS=0.01
# Optional hard cap: refuse an order whose risk (|entry - SL| x lots x contract
# size) exceeds this many account-currency units. Unset => no extra cap; the
# broker's margin and volume rules still apply. When set and the contract size
# is not yet known, the order is refused (fail closed).
MT5_MAX_RISK_PER_TRADE=
# How long Node 4 waits for the bridge's *confirmed* fill before treating the
# outcome as unknown (never "opened"). Keep it above the bridge's own
# MT5_ORDER_TIMEOUT_MS.
MT5_ORDER_TIMEOUT_MS=15000
# Page size used when asking the bridge for closed-deal history.
MT5_HISTORY_PAGE_SIZE=100
