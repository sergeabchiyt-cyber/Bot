# mt5-bridge — Deriv MT5 DEMO execution bridge (copy to .env, never commit it)
# --------------------------------------------------------------------------
# Runs ON THE MACHINE WITH THE MT5 TERMINAL (Windows / Wine), not on the Node 4
# host. Deployment shape: ../docs/mt5/EXECUTION_ARCHITECTURE.md
# Only MT5_LOGIN / MT5_PASSWORD live here; Node 4 never sees them.

# --- Node 4 link (the bridge dials out to WS /mt5/bridge; no inbound port) --
NODE4_WS_URL=wss://execution-southeastasia-sng-main.onrender.com/mt5/bridge
# Must equal Node 4's MT5_BRIDGE_TOKEN. Generate: openssl rand -hex 32
MT5_BRIDGE_TOKEN=
# Optional: override the protocol version the bridge announces (default 1).
# MT5_PROTOCOL=1

# --- Terminal link (the EA dials into this loopback listener) ---------------
MT5_EA_BIND_ADDR=127.0.0.1
MT5_EA_PORT=5055
# Must equal the EA input InpToken. UNSET => READ-ONLY BRIDGE (no orders at all).
MT5_EA_TOKEN=

# --- Terminal credentials (presence-validated; never transmitted/logged) ----
MT5_LOGIN=
MT5_PASSWORD=

# --- Instrument and sizing --------------------------------------------------
# The strategy's instrument. Anything other than XAUUSD needs the opt-in below.
MT5_SYMBOL=XAUUSD
# Explicit broker-symbol overrides only, `requested=broker` pairs. Suffixes such
# as XAUUSD.a are NEVER guessed; without a mapping a missing symbol is an error.
MT5_SYMBOL_MAP=
MT5_ALLOW_OTHER_SYMBOL=0
# Order size in LOTS. NOT ORDER_SIZE (that is a Deriv options stake in USD).
# 0.01 lot of XAUUSD = 1 oz => $1.00 of movement is $1.00 of P&L.
MT5_VOLUME_LOTS=0.01
# Optional cap on |entry - SL| x volume x contract size, in account currency.
MT5_MAX_RISK_PER_TRADE=
MT5_MAX_DEVIATION_POINTS=20
MT5_MAGIC=330033

# --- Timeouts and freshness -------------------------------------------------
MT5_ORDER_TIMEOUT_MS=15000
MT5_REQUEST_TIMEOUT_MS=5000
MT5_ACCOUNT_MAX_AGE_MS=5000
MT5_MAX_QUOTE_AGE_MS=3000
MT5_PUSH_INTERVAL_MS=2000

# --- History and safety -----------------------------------------------------
MT5_HISTORY_FILE=data/mt5_history.jsonl
MT5_HISTORY_PAGE_SIZE=100
# 0 = start halted (monitoring only, no orders).
MT5_TRADING_ENABLED=1
# Halt trading when the EA link drops.
MT5_HALT_ON_EA_DISCONNECT=1
# Run against the in-process FAKE terminal: protocol work only, no broker.
MT5_SIM_TERMINAL=0

RUST_LOG=info
