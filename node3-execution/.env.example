# Node 1 Connection
NODE1_WS_URL=wss://engine-southeastasia-sng-main.onrender.com/ws

# Local HTTP & WebSocket port — hosting platforms inject PORT
PORT=10000

# Execution Venues (only 1 minimum required)
# Deriv demo token: legacy `a1-...` (no app id needed) or `pat_...` (needs DERIV_APP_ID).
DERIV_DEMO_API=your_deriv_token
# Required ONLY for PAT (pat_...) tokens: App ID from https://developers.deriv.com (API dashboard).
DERIV_APP_ID=
# Optional: default https://api.derivws.com (current REST + OTP API).
DERIV_API_URL=https://api.derivws.com
# or: Chelsea Live MCP
# MCP_CHELSEA_URL=http://localhost:3002/mcp

# Strategy Parameters
VOLUME_THRESHOLD=10500
SL_MIN_PIPS=200
SL_MAX_PIPS=300
TP_MIN_PIPS=600
TP_MAX_PIPS=800
RR_MIN=2.0
RR_MAX=3.0
ORDER_SIZE=0.01
RUST_LOG=info
