# Node 1 Connection
NODE1_WS_URL=wss://engine-southeastasia-sng-main.onrender.com/ws

# Local HTTP & WebSocket port — hosting platforms inject PORT
PORT=10000

# Execution Venues — EXACTLY ONE may be configured.
# Setting a second one is a startup error on purpose: the strategy must never be
# able to trade two accounts at once. Venue is auto-detected when exactly one
# credential set is present; set EXECUTION_VENUE explicitly to be unambiguous.
#   deriv_mt5_demo | deriv_demo | chelsea_live | none
EXECUTION_VENUE=

# Deriv demo token: legacy `a1-...` (no app id needed) or `pat_...` (REQUIRES DERIV_APP_ID).
# A PAT (pat_...) without DERIV_APP_ID fails with:
#   HTTP 401: Deriv-App-ID header is required for PAT tokens
DERIV_DEMO_API=your_deriv_token
# REQUIRED whenever DERIV_DEMO_API is a PAT (pat_...) token, ignored for legacy a1-... tokens.
# Free app registration: https://developers.deriv.com  (API dashboard) -> create an app -> copy its App ID.
# Must be set in the environment of the running service (e.g. Render -> Environment), not only in a local .env.
DERIV_APP_ID=
# Optional: default https://api.derivws.com (current REST + OTP API).
# Leave as-is for PAT tokens; legacy a1-... tokens may use wss://ws.derivws.com/websockets/v3.
DERIV_API_URL=https://api.derivws.com
# or: Chelsea Live MCP
# MCP_CHELSEA_URL=http://localhost:3002/mcp

# ---------------------------------------------------------------------------
# Deriv MT5 **demo** venue (no MT5 password ever reaches Node 3)
# ---------------------------------------------------------------------------
# The bridge runs NEXT TO the MT5 terminal (see docs/mt5/EXECUTION_ARCHITECTURE.md),
# dials out to this service's /ws and authenticates with this token via
# `bridge_hello`. Node 3 never connects to the bridge, and never sees
# MT5_LOGIN / MT5_PASSWORD — those are read by the bridge from its own env.
#   MT5_BRIDGE_TOKEN
#
# Shared secret used both for the bridge handshake above and for the control
# endpoint below. Absent => the MT5 venue is unconfigured and /mt5/* stays inert.
# Generate one:  openssl rand -hex 32
MT5_BRIDGE_TOKEN=
#
# Operator kill switch: `POST /mt5/control` {action: halt|resume|close_all|
# close_position} with header `X-Control-Token: $MT5_CONTROL_TOKEN`.
# Unset => 403 for every caller (remote control disabled), which is the default.
MT5_CONTROL_TOKEN=
#
# Requested instrument (the strategy is XAUUSD-only) and the broker's symbol for
# it. Usually the same on Deriv MT5 (`XAUUSD`); some servers suffix it
# (`XAUUSD.a`) or call it `GOLD`. Mapping is NEVER guessed — either the exact
# name works, or MT5_SYMBOL_MAP must say so.
MT5_SYMBOL=XAUUSD
# Broker-symbol overrides, `requested=broker` pairs: MT5_SYMBOL_MAP=XAUUSD=XAUUSD.a,XAUUSD.m=GOLD
MT5_SYMBOL_MAP=
# Set only if a non-XAUUSD instrument is genuinely intended.
MT5_ALLOW_OTHER_SYMBOL=0
#
# Order size in LOTS. NOT ORDER_SIZE: that value is a Deriv *options stake* in
# USD and has nothing to do with a MetaTrader lot. On Deriv MT5, 1.00 lot of
# XAUUSD is 100 oz, so 0.01 lot is 1 oz and $1 of XAUUSD movement is USD 0.01.
# The bridge re-validates this against volume_min/max/step from the terminal and
# refuses the order if the grid does not accept it.
MT5_VOLUME_LOTS=0.01
# Optional hard cap: refuse an order whose risk (|entry - SL| x lots x contract
# size) exceeds this many account-currency units. Unset => no extra cap; the
# broker's margin + volume rules still apply.
MT5_MAX_RISK_PER_TRADE=
#
# How long Node 3 waits for the bridge's *confirmed* fill before treating the
# outcome as unknown (never "opened"). Keep it above the bridge's own
# MT5_ORDER_TIMEOUT_MS.
MT5_ORDER_TIMEOUT_MS=15000
# Page size used when asking the bridge for closed-deal history.
MT5_HISTORY_PAGE_SIZE=100

# Strategy Parameters
VOLUME_THRESHOLD=10500
SL_MIN_PIPS=200
SL_MAX_PIPS=300
TP_MIN_PIPS=600
TP_MAX_PIPS=800
RR_MIN=2.0
RR_MAX=3.0
# Stake (USD) sent to Deriv, and the minimum Deriv will price. Deriv answers a
# smaller stake with InvalidMinStake ("Please enter a stake amount that's at
# least 0.50." for frxXAUUSD on a USD demo account), so ORDER_SIZE below
# DERIV_MIN_STAKE is clamped up and a warning is logged.
ORDER_SIZE=0.50
DERIV_MIN_STAKE=0.50
RUST_LOG=info
