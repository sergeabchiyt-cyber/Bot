# Node3 16GB / 4vCPU / 400GB — upgraded tier config
NODE1_WS_URL=wss://engine-southeastasia-sng-main.onrender.com/ws
SESSION_ID=ai-01
RUST_LOG=info
KEEP_ALIVE_INTERVAL=45
RECONNECT_MIN_DELAY=1
RECONNECT_MAX_DELAY=30
PING_INTERVAL=20
MODEL_DIR=models

# --- Upgraded tier preferences (16GB box) ---
# Moonshine: medium (245M, 15% better WER) vs small (123M, lighter)
MOONSHINE_PREFERRED=medium
MOONSHINE_INTRA_THREADS=4
MOONSHINE_INTER_THREADS=1
MOONSHINE_VAD_THRESHOLD=0.45

# FinBERT: fomc (FOMC-RoBERTa 355M, 93% FOMC acc) > tone > finbert
FINBERT_PREFERRED=fomc
FINBERT_INTRA_THREADS=4
FINBERT_INTER_THREADS=1

# Optional explicit overrides (if models stored elsewhere on 400GB disk)
# FINBERT_MODEL_DIR=/teamspace/studios/this_studio/xauusd-node3/node3-ai/models/fomc-roberta
# MOONSHINE_MODEL_DIR=/teamspace/studios/this_studio/xauusd-node3/node3-ai/models/moonshine-streaming-medium-onnx

# Learner (v2 Adam) — usually defaults are fine
# LEARNER_LR=0.02
